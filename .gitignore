# Environment variables
.env
.env.*
!.env.example
!.env.*.example

# Node modules
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs
frontend/build/
frontend/dist/

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db
*:Zone.Identifier

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Docker
docker-compose.override.yml

# Test coverage
coverage/
.coverage
.hypothesis/

# Python
*.py.bak
*.py.old
__pycache__/

# Dev containers
.devcontainer/

# ChromaDB local data
chromadb/

# Reference screenshots
*.png
!frontend/public/*.png
# public/images 配下はアプリが実際に配信する素材なので追跡する。
# 上の !frontend/public/*.png は直下1階層しか拾わず、images/home/... が
# 巻き込まれてビルドから抜け落ちる（プレビュー・本番で画像が壊れる）。
!frontend/public/images/**/*.png

# Documentation (non-essential)
*.md
!**/README.md
# Claude 作業ルールとモック開発ガイドは追跡する
!CLAUDE.md
!frontend/docs/*.md

# Temporary files
*.tmp
*.temp

# MCP configuration with secrets
mcp.json

# SSH keys
*.pem
*.ppk

# SSL certificates
ssl/

# Environment-specific CDK configs
cdk-prod/
cdk-uat/

# GitHub Actions workflows
.github/

# Test suites
tests/

# Clipkit 教材エクスポート（LMS移行用の中間データ・認証状態）
# storageState にはセッションCookieが入るので絶対に追跡しない。
materials/source/
tools/clipkit-export/.auth/
tools/clipkit-export/clipkit.config.json
