# Environment files
.env
mcp.json

# Data directories
moodle-data/
moodle-html/
mysql-data/

# Temporary files
*.log
*.tmp
cookies.txt

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Node modules
node_modules/

# Test tokens (do not commit!)
.id-token
*.token

# Documentation (exclude MD files)
*.md
!README.md

# Test scripts
test-*.sh
test-*.js

# Build scripts
build-*.sh
load-*.sh
exec-*.sh
export-*.sh
update-*.sh
restore-*.sh
check-*.sh

# Exception for special tables migration scripts
!scripts/db/export-special-tables.sh
!scripts/db/import-special-tables.sh

# Backup files
*.backup
*.bak

# Python cache
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.coverage
.hypothesis/

# CDK build output directories (NOT the cdk-prod/cdk-dev/cdk-uat source dirs themselves —
# a bare "cdk-*/" here previously blackholed those entire projects from git tracking)
cdk-prod/cdk.out*/
cdk-dev/cdk.out*/
cdk-uat/cdk.out*/

# Moodle source (ignore everything except customizations)
moodle/*
!moodle/customizations/

# SQL files
sql/

# tar archives
*.tar.gz

# RDS migration
rds-migration/
