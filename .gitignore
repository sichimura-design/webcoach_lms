# Environment files
.env
mcp.json

# Data directories
moodle-data/
moodle-html/
mysql-data/

# Temporary files
*.log
*.tmp
cookies.txt

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Node modules
node_modules/

# Test tokens (do not commit!)
.id-token
*.token

# Documentation (exclude MD files)
*.md
!README.md

# Test scripts
test-*.sh
test-*.js

# Build scripts
build-*.sh
load-*.sh
exec-*.sh
export-*.sh
update-*.sh
restore-*.sh
check-*.sh

# Exception for special tables migration scripts
!scripts/db/export-special-tables.sh
!scripts/db/import-special-tables.sh

# Backup files
*.backup
*.bak

# Python cache
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.coverage
.hypothesis/

# CDK build output directories (NOT the cdk-prod/cdk-dev/cdk-uat source dirs themselves —
# a bare "cdk-*/" here previously blackholed those entire projects from git tracking)
cdk-prod/cdk.out*/
cdk-dev/cdk.out*/
cdk-uat/cdk.out*/

# Moodle source (ignore everything except customizations)
moodle/*
!moodle/customizations/

# SQL files
sql/

# tar archives
*.tar.gz

# RDS migration
rds-migration/

# Reference screenshots
*.png
!frontend/public/*.png
# public/images 配下はアプリが実際に配信する素材なので追跡する。
# 上の !frontend/public/*.png は直下1階層しか拾わず、images/home/... が
# 巻き込まれてビルドから抜け落ちる（プレビュー・本番で画像が壊れる）。
!frontend/public/images/**/*.png
# public/mascot 配下も同様にアプリが配信する素材（CharacterAvatar が参照する）。
!frontend/public/mascot/*.png

# Documentation (non-essential)
# Claude 作業ルールとモック開発ガイドは追跡する
!CLAUDE.md
!frontend/docs/*.md
# UI/UXレビューの段取り・観点定義は複数人で共有するので追跡する。
# 上の !frontend/docs/*.md は直下1階層しか拾わず、ui-review/ 配下が巻き込まれる。
!frontend/docs/**/*.md

# Temporary files
*.temp

# SSH keys
*.pem
*.ppk

# SSL certificates
ssl/

# Test suites
tests/

# Clipkit 教材エクスポート（LMS移行用の中間データ・認証状態）
# storageState にはセッションCookieが入るので絶対に追跡しない。
materials/source/
tools/clipkit-export/.auth/
tools/clipkit-export/clipkit.config.json

# 変換後の教材データ（materials/source から再生成できる中間データ・約55MB）
materials/lessons/

# NOTE: cdk-prod/・cdk-uat/・.github/ をまるごとignoreするルールは意図的に採用していない。
# cdk-prod/はprod用CDKソースの正式な置き場所（上のCDK build output directoriesの
# 警告コメント参照）、.github/は実際にCIワークフローを追跡しているため、
# 一括ignoreすると git 管理から丸ごと外れてしまう。

# Claude のローカル設定・worktree（各自の環境依存なので共有しない）
.claude/

# デザイン受領物・配布物の展開先（リポジトリの成果物ではなく作業用の置き場）
__MACOSX/
design_handoff_lms_app/
フロントデザイン/
web-production*/
harness-starter/
poc/

# Claude Design のキャンバス下書き
*.dc.html
