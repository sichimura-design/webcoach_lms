# Environment variables
.env
.env.*
!.env.example
!.env.*.example

# Node modules
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs
frontend/build/
frontend/dist/

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db
*:Zone.Identifier

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Docker
docker-compose.override.yml

# Test coverage
coverage/
.coverage
.hypothesis/

# Python
*.py.bak
*.py.old
__pycache__/

# Dev containers
.devcontainer/

# ChromaDB local data
chromadb/

# Reference screenshots
*.png
!frontend/public/*.png
# public/images 配下はアプリが実際に配信する素材なので追跡する。
# 上の !frontend/public/*.png は直下1階層しか拾わず、images/home/... が
# 巻き込まれてビルドから抜け落ちる（プレビュー・本番で画像が壊れる）。
!frontend/public/images/**/*.png
# public/mascot 配下も同様にアプリが配信する素材（CharacterAvatar が参照する）。
!frontend/public/mascot/*.png

# Documentation (non-essential)
*.md
!**/README.md
# Claude 作業ルールとモック開発ガイドは追跡する
!CLAUDE.md
!frontend/docs/*.md
# UI/UXレビューの段取り・観点定義は複数人で共有するので追跡する。
# 上の !frontend/docs/*.md は直下1階層しか拾わず、ui-review/ 配下が巻き込まれる。
!frontend/docs/**/*.md

# Temporary files
*.tmp
*.temp

# MCP configuration with secrets
mcp.json

# SSH keys
*.pem
*.ppk

# SSL certificates
ssl/

# Environment-specific CDK configs
cdk-prod/
cdk-uat/

# GitHub Actions workflows
.github/

# Test suites
tests/

# Clipkit 教材エクスポート（LMS移行用の中間データ・認証状態）
# storageState にはセッションCookieが入るので絶対に追跡しない。
materials/source/
tools/clipkit-export/.auth/
tools/clipkit-export/clipkit.config.json

# 変換後の教材データ（materials/source から再生成できる中間データ・約55MB）
materials/lessons/

# Claude のローカル設定・worktree（各自の環境依存なので共有しない）
.claude/

# デザイン受領物・配布物の展開先（リポジトリの成果物ではなく作業用の置き場）
__MACOSX/
design_handoff_lms_app/
フロントデザイン/
web-production*/
harness-starter/
poc/

# Claude Design のキャンバス下書き
*.dc.html
